{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tempo/web", "dev", "-p", "3001"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "tempo-engine",
      "runtimeExecutable": "tempo-engine/.venv/Scripts/python.exe",
      "runtimeArgs": ["tempo-engine/scripts/run_api.py", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001,
      "url": "http://127.0.0.1:8001"
    }
  ]
}
