    "SectionSignals": {
      "description": "\"4 dari 6 sinyal tersedia\" for one section.\n\n`available` counts the distinct generators that actually contributed a\nfinding to this section. `total` adds every generator that skipped with a\ncoverage gap \u2014 deliberately conservative: a generator that never ran has no\nfindings, so its section affinity is unknowable, and counting it against\nevery section can understate coverage but can never overstate it.",
      "properties": {
        "available": {
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "available",
        "total"
      ],
      "title": "SectionSignals",
      "type": "object"
    },
