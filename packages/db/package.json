{
  "name": "@tempo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "esbuild src/scripts/scheduler.ts --bundle --platform=node --format=cjs --outfile=dist/scheduler.cjs --external:pg --external:@electric-sql/pglite",
    "clean": "rm -rf dist .turbo",
    "db:inspect": "tsx --env-file-if-exists=../../.env src/scripts/inspect-hourly.ts",
    "db:inspect-tempo": "tsx --env-file-if-exists=../../.env src/scripts/inspect-tempo.ts",
    "db:sanitize": "tsx --env-file-if-exists=../../.env src/scripts/sanitize.ts",
    "db:scheduler": "tsx --env-file-if-exists=../../.env src/scripts/scheduler.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tempo/core": "workspace:*",
    "@tempo/tiktok": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tempo/eslint-config": "workspace:*",
    "@tempo/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
