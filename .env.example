# =============================================================================
# Tempo Insight Engine — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env (see .gitignore).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL unset to use the zero-config embedded PGlite database
# (great for local dev / demos). Set it to a Postgres URL for staging/prod.
# DATABASE_URL=postgres://user:password@localhost:5432/tempo
#
# Where the embedded PGlite database persists (relative to repo root):
PGLITE_DATA_DIR=.pglite/tempo

# --- TikTok data provider --------------------------------------------------
# 'fixture' serves deterministic synthetic data (no credentials needed).
# 'csv'     serves a real brand export from disk (see the CSV block below).
# 'live' talks to the real TikTok APIs. If unset, the app auto-selects 'live'
# only when credentials below are present, otherwise 'fixture'.
TIKTOK_DATA_PROVIDER=fixture

# --- CSV export (committed Cimory demo set) --------------------------------
# The repo ships data/cimory-hourly.csv. To load Cimory instead of the fixture
# demo tenant, set the provider to 'csv' above and uncomment this block, then
# run `pnpm db:migrate && pnpm db:seed`:
# TIKTOK_CSV_PATH=./data/cimory-hourly.csv
# TIKTOK_CSV_ADVERTISER_ID=cimory-tiktok-ads
# TIKTOK_CSV_CLIENT_NAME=Cimory
# TIKTOK_CSV_CLIENT_SLUG=cimory
# TIKTOK_CSV_AGENCY_NAME=Buzzo Media
# TIKTOK_CSV_AGENCY_SLUG=buzzo-media

# --- TikTok Business / Marketing API (PAID surface) ------------------------
# Create an app at https://business-api.tiktok.com/portal
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_BUSINESS_ACCESS_TOKEN=
# TIKTOK_BUSINESS_BASE_URL=https://business-api.tiktok.com   # or sandbox

# --- TikTok Display / Content API (ORGANIC surface) ------------------------
# Create an app at https://developers.tiktok.com
# TIKTOK_DISPLAY_CLIENT_KEY=
# TIKTOK_DISPLAY_CLIENT_SECRET=
# TIKTOK_DISPLAY_BASE_URL=https://open.tiktokapis.com

# --- Background jobs (Phase 2: scheduled ingestion) ------------------------
# REDIS_URL=redis://localhost:6379

# --- Report narration -------------------------------------------------------
# Nothing to configure here. The surface does not narrate: every analytical
# claim on a deck is a Finding from tempo-engine, which owns its own model
# connection (see tempo-engine/.env.example) along with the numeral, schema and
# metric gates that decide whether generated prose is accepted at all.

# --- Report API access (for portal.buzzohero.co.id) ------------------------
# Comma-separated keys. External callers send one as `X-API-Key` or
# `Authorization: Bearer <key>`. Same-origin requests from this app skip it.
# Generate with: openssl rand -hex 32
# REPORT_API_KEYS=

# Origins allowed to call cross-origin from a browser.
# REPORT_ALLOWED_ORIGINS=https://portal.buzzohero.co.id

# --- Shared report links (/r/:token) ----------------------------------------
# The portal's "Generate Report" asks POST /api/report-links (API key only, no
# same-origin pass) for a brand's link and opens it. Brands open that link with
# no Tempo login, so /r/* — and ONLY /r/* — must be reachable from outside;
# everything else here stays internal. This is the external origin the issued
# links point at; unset, links use whatever origin the request arrived on.
# REPORT_SHARE_BASE_URL=https://report.buzzohero.co.id

# --- Robot Pintar PostgreSQL credentials ---
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# --- Brief Deck pre-generation ---------------------------------------------
# The full tier costs minutes per deck, so a weekly job renders them overnight
# and the route serves the stored PDF (see docs/phases/brief-deck/). The job
# calls the report API as an external caller, so its key must be one of
# REPORT_API_KEYS above.
# DECK_CRON_API_KEY=
# TEMPO_APP_URL=http://127.0.0.1:3000
# DECK_CRON_SCHEDULE=0 3 * * 1          # Mondays at 03:00
# TEMPO_ARTIFACT_DIR=.tempo-media/decks
# DECK_ARTIFACT_MAX_AGE_HOURS=24        # older artifacts regenerate

# --- Brief Deck media cache -------------------------------------------------
# Where video thumbnails are cached at ingestion. TikTok CDN URLs expire and the
# deck renders with no network access, so the bytes are fetched once here and
# embedded into the PDF. A miss is a branded placeholder, never a broken image.
# TEMPO_MEDIA_DIR=.tempo-media/thumbnails

# --- Tempo Intelligence Engine (Awareness/GMV/Install briefs) --------------
# A separate Python service (sibling repo, D:\tempo-engine) that generates
# the three objective-specific briefs — see apps/web/src/app/api/reports/
# [slug]/brief/[objective]/route.ts. Run it with
# `pnpm --filter ecosystem` / `pm2 start ecosystem.config.cjs`, or directly:
# `.venv/Scripts/python.exe scripts/run_api.py` from D:\tempo-engine.
# Also needs its own TEMPO_ENGINE_DATABASE_URL and a reachable LM Studio
# server — see that repo's own README, not this file.
# TEMPO_ENGINE_URL=http://127.0.0.1:8001
#
# The engine is now co-located in this repo under tempo-engine/ (it is started
# by `pm2 start ecosystem.config.cjs` alongside the web app), not a sibling
# checkout — the path above is historical.
#
# The brief route asks for tier=instant by default, which needs no LM Studio at
# all; only tier=full (the weekly cron, and the "Analisis Lengkap" button) runs
# the agent path. `GET /healthz` on the engine reports liveness and last-run
# stats.

# --- Sanitizer schedule (packages/db) ----------------------------------------
# `tempo-sanitizer-cron` (pm2) runs the warehouse → Tempo sync on this cron,
# Asia/Jakarta. The web app also re-syncs in the background when data is stale.
# SANITIZE_CRON_SCHEDULE=0 2 * * *      # daily at 02:00
# AUTO_SYNC_INTERVAL_MS=1800000         # web background re-sync, 30 min

# --- TikTok Market Scope mirror (Strategy Report) ---------------------------
# The sanitizer copies the portal's ttms_* tables (same DB_* database as above)
# into market_scope_*; `pnpm --filter @tempo/db db:market-scope` runs it alone
# and verifies row counts against the portal. First-run history depth:
# MARKET_SCOPE_BACKFILL_DAYS=400

# --- LM Studio (Template Report narration) -----------------------------------
# Read by apps/web's Template Report only. tempo-engine has its own LM Studio
# settings (hard-coded until Strategy Report P4 moves them to env).
# LM_STUDIO_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=google/gemma-4-12b

# --- PDF rendering (Playwright Chromium) -------------------------------------
# Optional: an explicit Chromium for HTML → PDF. Unset, Tempo tries the local
# Chrome, then Edge, then Playwright's own download.
# PLAYWRIGHT_CHROMIUM_PATH=
# PLAYWRIGHT_BROWSERS_PATH=

# --- Postgres-table provider (TIKTOK_DATA_PROVIDER=postgres) -----------------
# Read one TikTok "daily in hourly" table straight from Postgres instead of a
# CSV. Connection fields fall back to DB_* above.
# TIKTOK_PG_TABLE=
# TIKTOK_PG_HOST=
# TIKTOK_PG_PORT=
# TIKTOK_PG_DATABASE=
# TIKTOK_PG_USER=
# TIKTOK_PG_PASSWORD=
# TIKTOK_PG_ADVERTISER_ID=
# TIKTOK_PG_CLIENT_NAME=
# TIKTOK_PG_CLIENT_SLUG=
# TIKTOK_PG_AGENCY_NAME=
# TIKTOK_PG_AGENCY_SLUG=
# TIKTOK_PG_CURRENCY=IDR
# TIKTOK_PG_TIMEZONE=Asia/Jakarta
# TIKTOK_PG_BRAND_COLOR=
# TIKTOK_PG_NORTH_STAR=shop
# TIKTOK_PG_CONVERSION_METRIC=
# TIKTOK_PG_CONVERSION_VALUE_METRIC=
#
# CSV provider extras (alongside TIKTOK_CSV_* above):
# TIKTOK_CSV_CURRENCY=IDR
# TIKTOK_CSV_TIMEZONE=Asia/Jakarta
# TIKTOK_CSV_BRAND_COLOR=
# TIKTOK_CSV_NORTH_STAR=shop
# TIKTOK_CSV_CONVERSION_METRIC=
# TIKTOK_CSV_CONVERSION_VALUE_METRIC=
