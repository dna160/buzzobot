# =============================================================================
# Tempo Insight Engine — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env (see .gitignore).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL unset to use the zero-config embedded PGlite database
# (great for local dev / demos). Set it to a Postgres URL for staging/prod.
# DATABASE_URL=postgres://user:password@localhost:5432/tempo
#
# Where the embedded PGlite database persists (relative to repo root):
PGLITE_DATA_DIR=.pglite/tempo

# --- TikTok data provider --------------------------------------------------
# 'fixture' serves deterministic synthetic data (no credentials needed).
# 'csv'     serves a real brand export from disk (see the CSV block below).
# 'live' talks to the real TikTok APIs. If unset, the app auto-selects 'live'
# only when credentials below are present, otherwise 'fixture'.
TIKTOK_DATA_PROVIDER=fixture

# --- CSV export (committed Cimory demo set) --------------------------------
# The repo ships data/cimory-hourly.csv. To load Cimory instead of the fixture
# demo tenant, set the provider to 'csv' above and uncomment this block, then
# run `pnpm db:migrate && pnpm db:seed`:
# TIKTOK_CSV_PATH=./data/cimory-hourly.csv
# TIKTOK_CSV_ADVERTISER_ID=cimory-tiktok-ads
# TIKTOK_CSV_CLIENT_NAME=Cimory
# TIKTOK_CSV_CLIENT_SLUG=cimory
# TIKTOK_CSV_AGENCY_NAME=Buzzo Media
# TIKTOK_CSV_AGENCY_SLUG=buzzo-media

# --- TikTok Business / Marketing API (PAID surface) ------------------------
# Create an app at https://business-api.tiktok.com/portal
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_BUSINESS_ACCESS_TOKEN=
# TIKTOK_BUSINESS_BASE_URL=https://business-api.tiktok.com   # or sandbox

# --- TikTok Display / Content API (ORGANIC surface) ------------------------
# Create an app at https://developers.tiktok.com
# TIKTOK_DISPLAY_CLIENT_KEY=
# TIKTOK_DISPLAY_CLIENT_SECRET=
# TIKTOK_DISPLAY_BASE_URL=https://open.tiktokapis.com

# --- Background jobs (Phase 2: scheduled ingestion) ------------------------
# REDIS_URL=redis://localhost:6379

# --- Report narrative (LLM) ------------------------------------------------
# Who writes the report's analysis prose. The deterministic engine always
# computes the figures first; the model only interprets them, and every number
# it cites is verified against that computation before the report is accepted.
#
#   anthropic          Claude API (needs ANTHROPIC_API_KEY)
#   lmstudio           local LM Studio server (OpenAI-compatible)
#   openai-compatible  any other OpenAI-shaped endpoint (Ollama, vLLM, …)
#   off                deterministic prose only, no model
#
# Unset defaults to 'anthropic' when ANTHROPIC_API_KEY is present, else 'off'.
# REPORT_NARRATIVE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Local model (LM Studio: Developer → Start Server, then copy the model name)
# REPORT_NARRATIVE_PROVIDER=lmstudio
# REPORT_NARRATIVE_BASE_URL=http://localhost:1234/v1
# REPORT_NARRATIVE_MODEL=qwen2.5-14b-instruct
# REPORT_NARRATIVE_API_KEY=            # only if your server requires one

# REPORT_NARRATIVE_TIMEOUT_MS=120000
# REPORT_NARRATIVE_MAX_ATTEMPTS=2
# REPORT_NARRATIVE_STRICT=false        # true = fail instead of falling back

# --- Report API access (for portal.buzzohero.co.id) ------------------------
# Comma-separated keys. External callers send one as `X-API-Key` or
# `Authorization: Bearer <key>`. Same-origin requests from this app skip it.
# Generate with: openssl rand -hex 32
# REPORT_API_KEYS=

# Origins allowed to call cross-origin from a browser.
# REPORT_ALLOWED_ORIGINS=https://portal.buzzohero.co.id

# --- Robot Pintar PostgreSQL credentials ---
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# --- Tempo Intelligence Engine (Awareness/GMV/Install briefs) --------------
# A separate Python service (sibling repo, D:\tempo-engine) that generates
# the three objective-specific briefs — see apps/web/src/app/api/reports/
# [slug]/brief/[objective]/route.ts. Run it with
# `pnpm --filter ecosystem` / `pm2 start ecosystem.config.cjs`, or directly:
# `.venv/Scripts/python.exe scripts/run_api.py` from D:\tempo-engine.
# Also needs its own TEMPO_ENGINE_DATABASE_URL and a reachable LM Studio
# server — see that repo's own README, not this file.
# TEMPO_ENGINE_URL=http://127.0.0.1:8001
