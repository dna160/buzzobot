{
  "name": "tempo-insight-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Tempo Insight Engine \u2014 a consumer-grade TikTok analytics platform for marketing agencies and their clients.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "pnpm --filter @tempo/db db:generate",
    "db:migrate": "pnpm --filter @tempo/db db:migrate",
    "db:seed": "pnpm --filter @tempo/db db:seed",
    "db:inspect": "pnpm --filter @tempo/db db:inspect",
    "db:studio": "pnpm --filter @tempo/db db:studio",
    "ingest": "pnpm --filter @tempo/ingestion start",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@tempo/eslint-config": "workspace:*",
    "@tempo/tsconfig": "workspace:*",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
